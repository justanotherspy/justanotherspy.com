---
interface Props {
  href: string;
  tag: string;
  title: string;
  description?: string;
}

const { href, tag, title, description } = Astro.props;
---
<a href={href} class="card-link-wrap">
  <div class="proj-card">
    <div class="card-tag">{tag}</div>
    <div class="card-title">{title}</div>
    {description && <div class="card-desc">{description}</div>}
    <span class="card-link">View project →</span>
  </div>
</a>
