---
interface Row {
  key: string;
  value: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---
<div class="pd-meta-card">
  {rows.map(({ key, value }) => (
    <div class="pd-meta-row">
      <div class="pd-meta-key">{key}</div>
      <div class="pd-meta-val">{value}</div>
    </div>
  ))}
</div>
