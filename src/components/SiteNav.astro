---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  active?: 'home' | 'projects' | 'notes';
}

const { active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<nav class="site-nav">
  <a href={base} class="site-wm">justanotherspy</a>
  <div class="site-nav-links">
    <a href={base} class:list={['site-nav-link', active === 'home' && 'active']}>home</a>
    <a href={`${base}projects`} class:list={['site-nav-link', active === 'projects' && 'active']}>projects</a>
    <a href={`${base}notes`} class:list={['site-nav-link', active === 'notes' && 'active']}>notes</a>
    <ThemeToggle />
  </div>
</nav>
