---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  active?: 'home' | 'projects' | 'notes';
}

const { active } = Astro.props;
---
<nav class="site-nav">
  <a href="/" class="site-wm">justanotherspy</a>
  <div class="site-nav-links">
    <a href="/" class:list={['site-nav-link', active === 'home' && 'active']}>home</a>
    <a href="/projects" class:list={['site-nav-link', active === 'projects' && 'active']}>projects</a>
    <a href="/notes" class:list={['site-nav-link', active === 'notes' && 'active']}>notes</a>
    <ThemeToggle />
  </div>
</nav>
