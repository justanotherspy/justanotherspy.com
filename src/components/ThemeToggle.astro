---
<button class="nav-toggle" type="button" title="toggle theme" aria-label="Toggle theme" data-theme-toggle></button>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  const syncPressed = () => {
    const dark = document.body.dataset.theme === 'dark';
    buttons.forEach(btn => btn.setAttribute('aria-pressed', String(dark)));
  };
  syncPressed();

  // Keep the browser-chrome color in step with a manual toggle; the metas
  // default to prefers-color-scheme, which is wrong once the user overrides it.
  const syncThemeColor = (theme: string) => {
    document.querySelectorAll('meta[name="theme-color"]').forEach(meta => {
      meta.setAttribute('content', theme === 'dark' ? '#1A1814' : '#F5F2EE');
      meta.removeAttribute('media');
    });
  };

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const next = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
      // html carries the theme too, so the overscroll background matches
      document.documentElement.dataset.theme = next;
      document.body.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      syncPressed();
      syncThemeColor(next);
    });
  });
</script>
