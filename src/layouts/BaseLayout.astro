---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'projects' | 'notes' | 'deaddrop';
  wide?: boolean;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = 'A small place for projects and thinking.',
  active,
  wide = false,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/android-chrome-512x512.png', Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap.xml" />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#F5F2EE" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1A1814" media="(prefers-color-scheme: dark)" />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="justanotherspy" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content="justanotherspy logo" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&display=swap" rel="stylesheet" />
</head>
<body data-theme="light">
  <script is:inline>
    // Apply the saved/preferred theme synchronously, before children paint,
    // to avoid a flash of the default light theme for dark-mode visitors.
    (() => {
      try {
        const stored = localStorage.getItem('theme');
        const prefers = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored ?? (prefers ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        document.body.dataset.theme = theme;
      } catch {}
    })();
  </script>
  <a href="#main" class="skip-link">skip to content</a>
  <SiteNav active={active} />
  <main id="main" class={wide ? 'content-wide' : 'content'}>
    <slot />
  </main>
  <SiteFooter />
</body>
</html>
