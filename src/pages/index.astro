---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArchiveRow from '../components/ArchiveRow.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Talks and community events, newest first. Talk slides are copied into
// public/talks/ so they open in the browser's own PDF viewer.
const community = [
  {
    date: 'AUG 27 2026',
    title: 'claude code',
    meta: 'Claude community talk · slides ↗',
    href: '/talks/claude-code-2026-08-27.pdf',
    external: true,
  },
  {
    date: 'SEP 2026',
    title: 'clawd’s fable',
    meta: 'Claude Fable 5.1 build day · play →',
    href: '/clawds-fable/',
    external: false,
  },
];
---
<BaseLayout title="justanotherspy" active="home">
  <div class="stack-3" style="margin-bottom: 56px;">
    <div class="label">/ A PERSONAL SITE /</div>
    <h1 class="display">small tools,<br />built to be <span class="amp">read</span>.</h1>
    <p class="lede" style="margin-top: 6px;">
      I&rsquo;m <span class="redact"><span aria-hidden="true">NameRedact</span><span class="sr-only">[name redacted]</span></span>, a security and infrastructure engineer based in <span class="redact"><span aria-hidden="true">LocationRedact</span><span class="sr-only">[location redacted]</span></span>.
      I build small command line tools, most of them for working with Claude Code, and each one gets a proper write-up here: what it does, what shaped it, and what it refuses to do.
    </p>
  </div>

  <div class="stack-4" style="margin-bottom: 64px;">
    <div class="row-between">
      <h2 class="section"><span class="sec-num">01</span>projects</h2>
      <a href="/projects" class="link" style="font-size:13px;">All projects →</a>
    </div>
    <div class="home-projects-grid">
      {projects.map((p, i) => (
        <ProjectCard
          href={`/projects/${p.id}`}
          index={i + 1}
          tag={p.data.tag}
          title={p.data.title}
          description={p.data.description}
          stack={p.data.stack}
        />
      ))}
    </div>
  </div>

  <div class="stack-4" style="margin-bottom: 64px;">
    <h2 class="section"><span class="sec-num">02</span>getting them</h2>
    <div class="split is-stacked">
      <div class="split-prose">
        <p>
          The binaries come from one Homebrew tap, <a class="link" href="https://github.com/justanotherspy/homebrew-tap" target="_blank" rel="noopener">justanotherspy/homebrew-tap</a>, which carries garlic, garnish, shuck and sproot.
          I never edit the casks by hand: each tool&rsquo;s release pipeline regenerates its own cask and pushes it, and a release only becomes latest once its binaries and cask are both in place.
          Everything installs on macOS and Linux except garlic&rsquo;s cask, which is macOS only (on Linux, <code class="inline">cargo install garlic-ward</code>).
        </p>
        <p>
          I spend most of my day inside <a class="link" href="https://code.claude.com" target="_blank" rel="noopener">Claude Code</a>, so garlic and shuck also ship as plugins, catalogued in one marketplace, <a class="link" href="https://github.com/justanotherspy/claude-plugins" target="_blank" rel="noopener">justanotherspy/claude-plugins</a>, alongside sproot&rsquo;s config skills and an <code class="inline">output-styles</code> plugin.
          A tool&rsquo;s plugin lives in its own repo and the marketplace points at it, so the plugin and the binary it drives stay in step. garnish installs its own skills during <code class="inline">garnish setup</code>.
        </p>
      </div>
      <div class="code">
        <div class="code-hdr"><span>BASH · CLAUDE CODE</span><span>INSTALL</span></div>
        <pre class="code-body"><span class="tc"># the binaries: tap once, then install by short name</span>
<span class="tk">$</span> brew tap justanotherspy/tap
<span class="tk">$</span> brew install --cask garlic garnish shuck
&nbsp;
<span class="tc"># the plugins, from inside Claude Code</span>
<span class="tk">&gt;</span> /plugin marketplace add justanotherspy/claude-plugins
<span class="tk">&gt;</span> /plugin install garlic@justanotherspy
<span class="tk">&gt;</span> /plugin install shuck@justanotherspy</pre>
      </div>
    </div>
  </div>

  <div class="stack-4">
    <h2 class="section"><span class="sec-num">03</span>talks &amp; build days</h2>
    <div class="split-prose"><p>
      I give the occasional talk at Claude community events, and the slides land in <a class="link" href="https://github.com/justanotherspy/talks" target="_blank" rel="noopener">justanotherspy/talks</a>. If one leaves you with questions, open an issue there and I&rsquo;ll answer.
      At the <a class="link" href="https://claudecapetowncommunity.com" target="_blank" rel="noopener">Claude Cape Town Community</a>&rsquo;s Fable 5.1 build day I made <a class="link" href="/clawds-fable/">Clawd&rsquo;s Fable</a>, a ninety-second pixel-art platformer where Clawd, the Claude Code mascot, stomps blobs of AI slop. It&rsquo;s one self-contained HTML file with every sprite and sound generated in code, and it runs in the browser (arrow keys or WASD, space to jump).
    </p></div>
    <div>
      {community.map(c => (
        <ArchiveRow href={c.href} date={c.date} title={c.title} meta={c.meta} external={c.external} />
      ))}
    </div>
  </div>
</BaseLayout>
