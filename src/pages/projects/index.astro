---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<BaseLayout title="projects — justanotherspy" active="projects">
  <h1 class="page-title">projects</h1>
  <p class="lede" style="margin-top: 10px; color: var(--muted); max-width: 56ch;">
    Things I&rsquo;ve made, in various states of finished.
  </p>

  <div class="proj-grid" style="margin-top: 40px;">
    {projects.map(p => (
      <a href={`/projects/${p.id}`} class="card-link-wrap">
        <div class="proj-card">
          <div class="card-tag">{p.data.tag}</div>
          <div class="card-title">{p.data.title}</div>
          <div class="card-desc">{p.data.description}</div>
          <span class="card-link">View project →</span>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
