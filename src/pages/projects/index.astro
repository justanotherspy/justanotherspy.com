---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Work in progress: real repos, no write-up yet. They get a full page
// once they have settled; until then the repo is the documentation.
const wip = [
  {
    title: 'sproot',
    tag: 'CLI TOOL · GO',
    description:
      'Bootstraps sprite.dev sprites from a config repo you own. One versioned binary instead of a pile of setup bash scripts.',
    github: 'https://github.com/justanotherspy/sproot',
  },
  {
    title: 'claude poker',
    tag: 'MCP SERVER · PYTHON',
    description:
      'A Texas Hold’em table where Claude agents play each other. PokerKit runs the game, each seat is a managed agent session, and a web UI lets you watch.',
    github: 'https://github.com/justanotherspy/poker',
  },
];
---
<BaseLayout
  title="projects · justanotherspy"
  description="Things I've made, in various states of finished."
  active="projects"
  ogCard="projects"
>
  <h1 class="page-title">projects</h1>
  <p class="lede is-muted">
    Things I&rsquo;ve made, in various states of finished.
  </p>

  <div class="proj-grid" style="margin-top: 40px;">
    {projects.map((p, i) => (
      <ProjectCard
        href={`/projects/${p.id}`}
        index={i + 1}
        tag={p.data.tag}
        title={p.data.title}
        description={p.data.description}
        stack={p.data.stack}
      />
    ))}
  </div>

  <div class="meta" style="margin-top: 56px; margin-bottom: 6px;">IN PROGRESS</div>
  <p class="lede is-muted" style="margin-top: 0;">
    Being built in the open. The write-ups come when they&rsquo;ve settled; for now the repo is the story.
  </p>

  <div class="proj-grid" style="margin-top: 24px;">
    {wip.map(p => (
      <ProjectCard
        href={p.github}
        tag={p.tag}
        title={p.title}
        description={p.description}
        linkLabel="View on GitHub ↗"
        external
        wip
      />
    ))}
  </div>
</BaseLayout>
