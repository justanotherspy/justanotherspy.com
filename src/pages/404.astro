---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="not found · justanotherspy" description="This page doesn't exist." noindex>
  <div class="stack-3">
    <div class="label">/ 404 /</div>
    <h1 class="display">nothing buried here.</h1>
    <p class="lede is-muted">
      Whatever was at this address has been moved, removed, or never existed.
      No record of your visit was kept.
    </p>
    <p style="margin-top: 10px;">
      <a href="/" class="btn-back">← Back to the start</a>
    </p>
  </div>
</BaseLayout>
