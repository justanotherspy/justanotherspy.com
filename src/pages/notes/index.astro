---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveRow from '../../components/ArchiveRow.astro';

const allNotes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const latest = allNotes[0];
const earlier = allNotes.slice(1);

const monthShort = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', timeZone: 'UTC' }).toUpperCase();

const isoDate = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout
  title="notes — justanotherspy"
  description="Occasional writing on security, AI, and the quiet parts of building software."
  active="notes"
>
  <h1 class="page-title">notes</h1>
  <p class="lede is-muted">
    Occasional writing on security, AI, and the quiet parts of building software.
  </p>

  {latest && (
    <>
      <div class="meta" style="margin-top: 48px; margin-bottom: 14px;">LATEST</div>
      <a href={`/notes/${latest.id}`} class="card-link-wrap">
        <div class="proj-card is-hero">
          <div class="card-tag">{isoDate(latest.data.date)} · {latest.data.readingTime}</div>
          <div class="card-title">{latest.data.title}</div>
          <div class="card-desc">{latest.data.excerpt}</div>
          <span class="card-link">Read →</span>
        </div>
      </a>
    </>
  )}

  {earlier.length > 0 && (
    <>
      <div class="meta" style="margin-top: 48px; margin-bottom: 8px;">EARLIER</div>
      <div>
        {earlier.map(n => (
          <ArchiveRow
            href={`/notes/${n.id}`}
            date={monthShort(n.data.date)}
            title={n.data.title}
            readingTime={n.data.readingTime}
          />
        ))}
      </div>
    </>
  )}
</BaseLayout>
