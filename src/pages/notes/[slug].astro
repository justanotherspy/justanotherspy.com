---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import ProjectCard from '../../components/ProjectCard.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const related = note.data.relatedProject
  ? await getEntry(note.data.relatedProject)
  : undefined;

const isoDate = note.data.date.toISOString().slice(0, 10);
const metaLine = [isoDate, note.data.readingTime, note.data.wordCount]
  .filter(Boolean)
  .join(' · ');
---
<BaseLayout title={`${note.data.title} — justanotherspy`} active="notes">
  <a href="/notes" class="btn-back">← Back to notes</a>

  {note.data.hero && (
    <div style="margin-top: 24px;">
      <ImagePlaceholder label={note.data.hero} hero />
    </div>
  )}

  <div style="margin-top: 28px;">
    <div class="meta" style="margin-bottom: 10px;">{metaLine}</div>
    <h1 class="page-title">{note.data.title}</h1>
  </div>

  <div class="prose" style="margin-top: 28px;">
    <Content />
  </div>

  {related && (
    <>
      <hr class="sep" />
      <div class="meta" style="margin-bottom: 14px;">RELATED PROJECT</div>
      <ProjectCard
        href={`/projects/${related.id}`}
        tag={related.data.tag.split(' · ')[0]}
        title={related.data.title}
        description={related.data.description}
      />
    </>
  )}
</BaseLayout>
